APP_NAME=Semestra
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Separate Next.js frontend — see Technical direction / Hosting and domain in the plan.
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DigitalOcean Managed PostgreSQL — kept Postgres (not MySQL) for pgvector, see plan.
# Values below match docker-compose.yml's local postgres service exactly —
# for docker-compose use, set DB_HOST=postgres and leave the rest as-is.
# Replace all of these with real DO Managed Postgres values in production.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=semestra
DB_USERNAME=semestra
DB_PASSWORD=semestra

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# DigitalOcean Spaces (S3-compatible) — replaces Supabase Storage, see plan.
FILESYSTEM_DISK=spaces
# Notifications runtime: Laravel scheduler dispatching onto this queue, see plan.
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

# For docker-compose use, set REDIS_HOST=redis.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# DigitalOcean Spaces credentials (S3-compatible API) — used by the "spaces" disk in config/filesystems.php.
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_BUCKET=

# Server-side only — never exposed to the Next.js frontend, see AI operations in the plan.
OPENAI_API_KEY=

VITE_APP_NAME="${APP_NAME}"
