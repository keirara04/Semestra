# Local dev only — no nginx/supervisord, source bind-mounted by
# docker-compose, `php artisan serve` is enough for a dev loop.

FROM php:8.4-cli-alpine

RUN apk add --no-cache postgresql-dev icu-dev icu-libs $PHPIZE_DEPS \
    && docker-php-ext-install pdo pdo_pgsql bcmath pcntl intl

WORKDIR /app

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

EXPOSE 8000
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]
